<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.LaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      d:DataContext="{d:DesignInstance Type=models:LaunchViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="LaunchPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,4" Text="Quick Launch" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Open one or many Roblox windows into the same place. Use a single account for several windows, or launch every saved account at once. Multi-instancing is turned on automatically when more than one window is requested." />

        <controls:OptionControl
            Header="Allow multiple Roblox instances"
            Description="Required for more than one Roblox window. Ultrastrap holds the Roblox single-instance mutexes in a background watcher.">
            <ui:ToggleSwitch IsChecked="{Binding MultiInstanceLaunching, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Auto-tile new windows"
            Description="After a multi-window launch, arrange the new Roblox windows in a grid on your desktop.">
            <ui:ToggleSwitch IsChecked="{Binding AutoTileWindows, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl
            Header="Label windows with the account name"
            Description="Rename each Roblox window to Roblox — alias so you can tell accounts apart in the taskbar.">
            <ui:ToggleSwitch IsChecked="{Binding RenameWindowsByAccount, Mode=TwoWay}" />
        </controls:OptionControl>

        <TextBlock Margin="0,16,0,4" Text="Place" FontWeight="Medium" />
        <ui:TextBox Margin="0,0,0,8"
                    PlaceholderText="Place ID or https://www.roblox.com/games/..."
                    Text="{Binding PlaceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,4" Text="Specific server job ID (optional)" />
                <ui:TextBox PlaceholderText="Leave blank for automatic matchmaking"
                            Text="{Binding JobId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4" Text="Private server access code (optional)" />
                <ui:TextBox PlaceholderText="Leave blank for a public server"
                            Text="{Binding AccessCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,8,0,4" Text="Account for this launch" FontWeight="Medium" />
        <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Leave unselected to use whichever account the Roblox client is already signed into." />
        <ComboBox Margin="0,0,0,8"
                  ItemsSource="{Binding Accounts}"
                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  DisplayMemberPath="DisplayLabel" />

        <WrapPanel Margin="0,0,0,8">
            <ui:Button Margin="0,0,8,8" Content="Launch 1 window" Icon="Play24" Appearance="Primary"
                       IsEnabled="{Binding NotBusy}"
                       Command="{Binding LaunchSelectedCommand, Mode=OneTime}" />
            <ui:Button Margin="0,0,8,8" Content="Set as default account" Icon="Checkmark24"
                       IsEnabled="{Binding IsAccountSelected}"
                       Command="{Binding UseActiveAccountCommand, Mode=OneTime}" />
        </WrapPanel>

        <TextBlock Margin="0,8,0,4" Text="Same account, multiple windows" FontWeight="Medium" />
        <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Opens several clients as the selected account (or the currently signed-in one). Roblox may still kick a duplicate session of the same account out of the same experience — use different accounts for that." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="Windows" />
            <ui:NumberBox Width="100" Min="{Binding CopiesMinimum}" Max="{Binding CopiesMaximum}"
                          DecimalPlaces="0" IntegersOnly="True"
                          Value="{Binding Copies, Mode=TwoWay}" />
            <ui:Button Margin="12,0,0,0" Content="Launch copies" Icon="SquareMultiple24"
                       IsEnabled="{Binding NotBusy}"
                       Command="{Binding LaunchCopiesCommand, Mode=OneTime}" />
        </StackPanel>

        <TextBlock Margin="0,8,0,4" Text="Different accounts at once" FontWeight="Medium" />
        <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Starts one window per saved account, each with its own authentication ticket." />
        <ui:Button Margin="0,0,0,16" Content="Launch all saved accounts" Icon="PeopleTeam24" Appearance="Primary"
                   IsEnabled="{Binding NotBusy}"
                   Command="{Binding LaunchAllAccountsCommand, Mode=OneTime}" />

        <TextBlock Margin="0,0,0,4" Text="Favorites" FontWeight="Medium" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Favorite name (optional)"
                        Text="{Binding NewFavoriteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="2" Content="Save current place" Icon="Star24"
                       Command="{Binding AddFavoriteCommand, Mode=OneTime}" />
        </Grid>

        <ListBox Margin="0,0,0,8" MinHeight="80" MaxHeight="180"
                 ItemsSource="{Binding Favorites}"
                 SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayLabel}" Margin="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ui:Button Margin="0,0,0,12" Content="Remove favorite" Icon="Delete24"
                   IsEnabled="{Binding IsFavoriteSelected}"
                   Command="{Binding RemoveFavoriteCommand, Mode=OneTime}" />

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding StatusMessage, Mode=OneWay}" />
    </StackPanel>
</ui:UiPage>
